# ---- Tier 1: Unit Tests --------------------------------------------

class UnitTests_DataAccessLayer(unittest.TestCase):
    """Verifies PatientRepository storage & data-cleaning behaviour."""

    def test_mock_data_loads_four_patients(self):
        repo = PatientRepository()
        self.assertEqual(len(repo.get_all_patient_ids()), 4)

    def test_zero_bmi_is_replaced_with_median_of_others(self):
        # Craft controlled data: one patient has BMI 0, others are 20, 30, 40
        # -> median of [20, 30, 40] = 30
        data = [
            PatientRecord(1, "A", glucose=90, bmi=20, age=30, blood_pressure=70),
            PatientRecord(2, "B", glucose=90, bmi=30, age=30, blood_pressure=70),
            PatientRecord(3, "C", glucose=90, bmi=40, age=30, blood_pressure=70),
            PatientRecord(4, "D", glucose=90, bmi=0, age=30, blood_pressure=70),
        ]
        repo = PatientRepository(seed_data=data)
        self.assertEqual(repo.get_patient(4).bmi, 30)

    def test_nonzero_bmi_values_are_untouched(self):
        repo = PatientRepository()
        self.assertEqual(repo.get_patient(1).bmi, 24.5)

    def test_get_patient_returns_none_for_unknown_id(self):
        repo = PatientRepository()
        self.assertIsNone(repo.get_patient(999))

    def test_update_patient_persists_changes(self):
        repo = PatientRepository()
        updated = repo.update_patient(1, glucose=150)
        self.assertEqual(updated.glucose, 150)
        self.assertEqual(repo.get_patient(1).glucose, 150)

    def test_update_unknown_patient_returns_none(self):
        repo = PatientRepository()
        self.assertIsNone(repo.update_patient(999, glucose=100))


class UnitTests_BusinessLogicLayer(unittest.TestCase):
    """Verifies RiskScoringService scoring & categorization rules, including boundaries."""

    def test_glucose_scoring_boundaries(self):
        self.assertEqual(RiskScoringService.score_glucose(99), 0)
        self.assertEqual(RiskScoringService.score_glucose(100), 1)
        self.assertEqual(RiskScoringService.score_glucose(125), 1)
        self.assertEqual(RiskScoringService.score_glucose(126), 2)

    def test_bmi_scoring_boundaries(self):
        self.assertEqual(RiskScoringService.score_bmi(24.9), 0)
        self.assertEqual(RiskScoringService.score_bmi(25), 1)
        self.assertEqual(RiskScoringService.score_bmi(29.9), 1)
        self.assertEqual(RiskScoringService.score_bmi(30), 2)

    def test_age_scoring_boundaries(self):
        self.assertEqual(RiskScoringService.score_age(44), 0)
        self.assertEqual(RiskScoringService.score_age(45), 1)
        self.assertEqual(RiskScoringService.score_age(64), 1)
        self.assertEqual(RiskScoringService.score_age(65), 2)

    def test_blood_pressure_scoring_boundaries(self):
        self.assertEqual(RiskScoringService.score_blood_pressure(79), 0)
        self.assertEqual(RiskScoringService.score_blood_pressure(80), 1)
        self.assertEqual(RiskScoringService.score_blood_pressure(89), 1)
        self.assertEqual(RiskScoringService.score_blood_pressure(90), 2)

    def test_total_score_sums_all_components(self):
        patient = PatientRecord(1, "Test", glucose=126, bmi=30, age=65, blood_pressure=90)
        # All four metrics score "High" (2) -> total = 8
        self.assertEqual(RiskScoringService.calculate_total_score(patient), 8)

    def test_risk_categorization_boundaries(self):
        self.assertEqual(RiskScoringService.categorize_risk(0), "Low Risk")
        self.assertEqual(RiskScoringService.categorize_risk(2), "Low Risk")
        self.assertEqual(RiskScoringService.categorize_risk(3), "Moderate Risk")
        self.assertEqual(RiskScoringService.categorize_risk(5), "Moderate Risk")
        self.assertEqual(RiskScoringService.categorize_risk(6), "High Risk")
        self.assertEqual(RiskScoringService.categorize_risk(8), "High Risk")

    def test_generate_report_structure(self):
        patient = PatientRecord(1, "Test", glucose=90, bmi=22, age=30, blood_pressure=70)
        report = RiskScoringService.generate_report(patient)
        self.assertEqual(report["total_score"], 0)
        self.assertEqual(report["category"], "Low Risk")
        self.assertEqual(len(report["component_scores"]), 4)


# ---- Tier 2: End-to-End Tests ---------------------------------------

class EndToEndTests_FullUserJourney(unittest.TestCase):
    """
    Simulates a real user driving the console app through all 4 layers:
    Controller -> View (input) -> Model (lookup/update) -> Service (score)
    -> View (output). Verifies the layers integrate correctly.
    """

    def _run_scripted_session(self, scripted_inputs: List[str]) -> str:
        """Runs the controller with mocked stdin/stdout and returns captured output."""
        repository = PatientRepository()
        view = ConsoleView()
        controller = RiskAssessmentController(repository, RiskScoringService, view)

        captured_output = StringIO()
        with patch("builtins.input", side_effect=scripted_inputs), \
             patch("sys.stdout", new=captured_output):
            controller.run()

        return captured_output.getvalue()

    def test_full_journey_assess_without_modification(self):
        # Journey: main menu -> assess -> pick patient 1 -> no modification -> exit
        scripted_inputs = [
            "1",       # main menu: Assess Patient Risk
            "1",       # select patient ID 1
            "n",       # do not modify metrics
            "2",       # main menu: Exit
        ]
        output = self._run_scripted_session(scripted_inputs)

        self.assertIn("Current Clinical Profile: Somchai P.", output)
        self.assertIn("DIAGNOSTIC RISK REPORT", output)
        self.assertIn("RISK CATEGORY", output)
        self.assertIn("Goodbye", output)

    def test_full_journey_assess_with_modification_changes_score(self):
        # Journey: assess patient 4, bump glucose/bmi/age/bp into "High" bucket, verify report reflects it
        scripted_inputs = [
            "1",       # Assess Patient Risk
            "4",       # select patient ID 4
            "y",       # yes, modify metrics
            "180",     # glucose -> High
            "35",      # bmi -> High
            "70",      # age -> High
            "95",      # blood pressure -> High
            "2",       # Exit
        ]
        output = self._run_scripted_session(scripted_inputs)

        self.assertIn("Patient data updated.", output)
        self.assertIn("TOTAL SCORE          : 8", output)
        self.assertIn("RISK CATEGORY        : High Risk", output)

    def test_full_journey_invalid_patient_id_shows_error(self):
        scripted_inputs = [
            "1",       # Assess Patient Risk
            "999",     # invalid ID
            "2",       # Exit
        ]
        output = self._run_scripted_session(scripted_inputs)
        self.assertIn("No patient found with ID 999", output)

    def test_full_journey_non_numeric_id_shows_error(self):
        scripted_inputs = [
            "1",        # Assess Patient Risk
            "abc",      # non-numeric ID
            "2",        # Exit
        ]
        output = self._run_scripted_session(scripted_inputs)
        self.assertIn("Patient ID must be a number", output)

    def test_full_journey_invalid_menu_choice_shows_error(self):
        scripted_inputs = [
            "9",   # invalid main menu option
            "2",   # Exit
        ]
        output = self._run_scripted_session(scripted_inputs)
        self.assertIn("Invalid menu option", output)


# ---- Tier 3: Performance Tests ---------------------------------------

class PerformanceTests_ScoringBenchmark(unittest.TestCase):
    """
    Benchmarks the scoring pipeline's throughput/latency. Not a strict
    pass/fail clinical test -- primarily logs timing data, with a loose
    upper-bound sanity assertion to catch severe performance regressions.
    """

    ITERATIONS = 10_000
    MAX_ACCEPTABLE_AVG_SECONDS = 0.001  # generous ceiling: 1ms/op

    def test_single_patient_scoring_benchmark(self):
        patient = PatientRecord(1, "Benchmark", glucose=140, bmi=32, age=55, blood_pressure=88)

        start = time.perf_counter()
        for _ in range(self.ITERATIONS):
            RiskScoringService.generate_report(patient)
        elapsed = time.perf_counter() - start

        avg_per_op = elapsed / self.ITERATIONS
        print(f"\n[PERF] {self.ITERATIONS} scoring runs in {elapsed:.4f}s "
              f"(avg {avg_per_op * 1000:.5f} ms/op)")

        self.assertLess(avg_per_op, self.MAX_ACCEPTABLE_AVG_SECONDS,
                         "Average scoring time exceeded acceptable threshold.")

    def test_full_repository_batch_scoring_benchmark(self):
        """Benchmark scoring all patients in the repository repeatedly (simulates batch/report runs)."""
        repository = PatientRepository()
        patient_ids = repository.get_all_patient_ids()
        batches = 2_000

        start = time.perf_counter()
        for _ in range(batches):
            for pid in patient_ids:
                patient = repository.get_patient(pid)
                RiskScoringService.generate_report(patient)
        elapsed = time.perf_counter() - start

        total_ops = batches * len(patient_ids)
        avg_per_op = elapsed / total_ops
        print(f"[PERF] {total_ops} batch scoring ops in {elapsed:.4f}s "
              f"(avg {avg_per_op * 1000:.5f} ms/op)")

        self.assertLess(avg_per_op, self.MAX_ACCEPTABLE_AVG_SECONDS,
                         "Average batch scoring time exceeded acceptable threshold.")


def run_test_suite() -> None:
    """Discovers and runs all Unit / E2E / Performance tests with verbose output."""
    loader = unittest.TestLoader()
    suite = unittest.TestSuite()

    suite.addTests(loader.loadTestsFromTestCase(UnitTests_DataAccessLayer))
    suite.addTests(loader.loadTestsFromTestCase(UnitTests_BusinessLogicLayer))
    suite.addTests(loader.loadTestsFromTestCase(EndToEndTests_FullUserJourney))
    suite.addTests(loader.loadTestsFromTestCase(PerformanceTests_ScoringBenchmark))

    runner = unittest.TextTestRunner(verbosity=2)
    runner.run(suite)


